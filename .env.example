# Sin variables, la web arranca en modo demostración (datos en .data/demo-db.json).

# Supabase: al definir estas dos variables se usa la base de datos real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firma de la cookie de sesión en modo demo. Pon un valor largo y aleatorio en producción.
SESSION_SECRET=

# URL pública del sitio (para metadatos y redes sociales).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
